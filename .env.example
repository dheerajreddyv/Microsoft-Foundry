# Azure AI Foundry project and Prompt Agent
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=foundry-skills-agent
# Leave blank to resolve the latest compatible agent version.
FOUNDRY_AGENT_VERSION=
FOUNDRY_MODEL_NAME=<model-deployment-name>

# Azure Storage location for skill assets
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account>.blob.core.windows.net
AZURE_STORAGE_CONTAINER=<container-name>
AZURE_STORAGE_SKILLS_PREFIX=<skills-prefix>