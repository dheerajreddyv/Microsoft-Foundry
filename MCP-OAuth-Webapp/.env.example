# ---- Entra ID (Azure AD) app registration ----
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-with-secret

REDIRECT_URI=http://localhost:8765/auth/callback
AI_FOUNDRY_SCOPE=https://ai.azure.com/.default
SESSION_SECRET=long-random-string-here

# ---- Foundry project + agent (MUST already exist in the portal) ----
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project
AGENT_NAME=mcp-auth-test-oauth-custom

# ---- Optional ----
PORT=8765
LOG_LEVEL=INFO
