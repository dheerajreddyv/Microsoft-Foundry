# Copy this file to `.env` and fill in your values. Do not commit `.env`.
#
# Foundry project endpoint (Overview page of your project in the Foundry portal).
FOUNDRY_PROJECT_ENDPOINT=https://<your-project>.services.ai.azure.com

# Name of your MODEL DEPLOYMENT (not the model family).
# Use a reasoning-capable deployment if you want `text_reasoning` content.
FOUNDRY_MODEL=<your-model-deployment-name>
