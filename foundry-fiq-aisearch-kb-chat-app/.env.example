# Azure AI Search admin key (Portal > Search service > Keys)
AZURE_SEARCH_ADMIN_KEY=

# Azure AI Search resource names
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_KNOWLEDGE_BASE=hier2-kb
AZURE_SEARCH_KNOWLEDGE_SOURCE=hier2-ks
AZURE_SEARCH_INDEX=hier2-index
AZURE_SEARCH_INDEXER=hier2-indexer

# Blob storage used for uploads (Entra ID / RBAC auth)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=hier

# Microsoft Entra ID app registration
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=

# Flask session signing key - use a long random value in production
FLASK_SECRET_KEY=
