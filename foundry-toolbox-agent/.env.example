# ============================================================================
# Foundry Toolbox Agent — example environment configuration
# Copy this file to `.env` and fill in the values for your Foundry project.
# ============================================================================

# Foundry project endpoint (from the Overview page of your Foundry portal)
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Name of the hosted Foundry prompt agent to create / invoke.
# - create_agent_with_toolbox.py reads this and creates the agent (or
#   updates it if it already exists).
# - invoke_foundry_agent.py reads this to know which agent to call.
NEW_AGENT_NAME=ToolboxAgent

# Foundry Toolbox to attach. The toolbox must already exist in your project
# (created in the Foundry portal: Toolboxes -> Add toolbox).
TOOLBOX_NAME=TestToolbox

# Model deployment in your Foundry project. Used only when creating a fresh
# agent; ignored if the agent already exists.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Optional: name for the managed project connection that points at the
# toolbox MCP endpoint (default: "<toolbox-name-lowercase>-conn").
# TOOLBOX_CONNECTION_NAME=testtoolbox-conn

# Optional: override the system prompt used when creating a fresh agent.
# AGENT_INSTRUCTIONS=You are a helpful assistant with access to a Foundry toolbox.

# Optional: pin invocation to a specific agent version (otherwise @latest).
# FOUNDRY_AGENT_VERSION=1

# Optional: prompt sent by invoke_foundry_agent.py
# USER_PROMPT=Convert 40 celsius to fahrenheit
